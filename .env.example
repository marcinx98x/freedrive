FREEDRIVE_PORT=8080
FREEDRIVE_MAX_UPLOAD_MB=5120
FREEDRIVE_ADMIN_EMAIL=admin@freedrive.local
# Required on first start when the data volume has no users yet.
FREEDRIVE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional. If empty, FreeDrive generates and stores it in the data volume.
# Do not use publicly known example values. Must be at least 32 characters if set.
# FREEDRIVE_JWT_SECRET=

# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For / X-Real-IP.
# Leave empty unless FreeDrive sits behind a reverse proxy you control.
# Example (Synology reverse proxy on the Docker bridge): FREEDRIVE_TRUSTED_PROXIES=172.17.0.0/16
# FREEDRIVE_TRUSTED_PROXIES=
