# Copy to `.env` next to `docker-compose.yml` (same folder), e.g. /volume2/docker/freedrive/.env
# Do not commit real secrets. Leave FREEDRIVE_JWT_SECRET unset (uses jwt_secret.key in the data volume).

FREEDRIVE_PORT=8080
FREEDRIVE_DATA_PATH=/volume2/docker/freedrive/data
# Synology bind-mounts often need root; use 1000:1000 when the volume is writable by uid 1000
FREEDRIVE_UID=0
FREEDRIVE_GID=0
FREEDRIVE_ADMIN_EMAIL=admin@example.com
FREEDRIVE_ADMIN_PASSWORD=change-me-to-a-strong-password
FREEDRIVE_MAX_UPLOAD_MB=10240
# Reverse proxy only — comma-separated IPs/CIDRs, not a domain:
# FREEDRIVE_TRUSTED_PROXIES=172.17.0.0/16
FREEDRIVE_TRUSTED_PROXIES=
